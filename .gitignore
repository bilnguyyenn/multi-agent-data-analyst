__pycache__/
*.pyc
.pytest_cache/
# Keep the generated sample benchmark public; ignore ad-hoc user datasets.
data/*
!data/sample/
!data/sample/**
!data/sample.ground_truth.json
cassettes/
.env
.analyst_runs/
.analyst_memory/
.analyst_uploads/
.heldout_data/
node_modules/
frontend/dist/
# Publish the scorecard and the exact zero-error raw runs cited by its provenance.
eval_results/*
!eval_results/SCORECARD.md
!eval_results/TRAP_VARIANCE.md
!eval_results/critic_bench.json
!eval_results/raw_20260708_225100.json
!eval_results/raw_20260708_230513.json
!eval_results/raw_20260708_231643.json
!eval_results/raw_20260709_070312.json
!eval_results/raw_20260710_231212.json
!eval_results/raw_20260710_235446.json
# Held-out data are regenerated by seed. Publish scorecards and explicitly unignore
# only the complete raw runs cited by scorecard provenance.
heldout_eval_results/*
!heldout_eval_results/README.md
!heldout_eval_results/SCORECARD.md
.DS_Store
